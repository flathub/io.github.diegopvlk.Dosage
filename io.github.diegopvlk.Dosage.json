{
	"id": "io.github.diegopvlk.Dosage",
	"runtime": "org.gnome.Platform",
	"runtime-version": "50",
	"sdk": "org.gnome.Sdk",
	"command": "io.github.diegopvlk.Dosage",
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--device=dri",
		"--socket=wayland",
		"--system-talk-name=org.freedesktop.login1",
		"--socket=pulseaudio"
	],
	"cleanup": [
		"/include",
		"/lib/pkgconfig",
		"/share/gir-1.0"
	],
	"modules": [
		{
			"name": "libportal",
			"buildsystem": "meson",
			"config-opts": ["-Ddocs=false", "-Dvapi=false"],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/flatpak/libportal",
					"tag": "0.10.0",
					"commit": "c23024018c8eb076549a1517fcb2d7f80d3e2ed5"
				}
			]
		},
		{
			"name": "dosage",
			"buildsystem": "meson",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/diegopvlk/Dosage",
					"tag": "v2.1.9",
					"commit": "427d6a49c5808398424967bbf972db9dbb43ca39"
				}
			]
		}
	]
}

