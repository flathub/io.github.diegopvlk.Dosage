{
	"id": "io.github.diegopvlk.Dosage",
	"runtime": "org.gnome.Platform",
	"runtime-version": "51",
	"sdk": "org.gnome.Sdk",
	"command": "io.github.diegopvlk.Dosage",
	"finish-args": [
		"--share=ipc",
		"--socket=fallback-x11",
		"--device=dri",
		"--socket=wayland",
		"--system-talk-name=org.freedesktop.login1",
		"--socket=pulseaudio"
	],
	"cleanup": [
		"/include",
		"/lib/pkgconfig",
		"/share/gir-1.0"
	],
	"modules": [
		{
			"name": "libportal",
			"buildsystem": "meson",
			"config-opts": ["-Ddocs=false", "-Dvapi=false"],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/flatpak/libportal",
					"tag": "0.11.0",
					"commit": "fc4d62cfe131e8494c82f597f92b2234d584c367"
				}
			]
		},
		{
			"name": "dosage",
			"buildsystem": "meson",
			"builddir": true,
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/diegopvlk/Dosage",
					"tag": "v2.1.9",
					"commit": "1dab9a4c569be29451ef33527164120a21de58db"
				}
			]
		}
	]
}

